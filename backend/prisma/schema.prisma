generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  TT
  QD
  KT
  AD
}

enum OrgUnitType {
  COMPANY
  SITE
  BLOCK
  DEPARTMENT
  TEAM
}

enum EmployeeStatus {
  ACTIVE
  TERMINATED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

model WageRegion {
  code  String @id @db.VarChar(3)
  name  String @db.VarChar(100)
  sites Site[]
  insuranceRates InsuranceRate[]
  @@map("wage_region")
}

model Site {
  id             String @id @default(uuid()) @db.Uuid
  code           String @unique @db.VarChar(32)
  name           String @db.VarChar(150)
  address        String
  wageRegionCode String @map("wage_region_code") @db.VarChar(3)
  wageRegion     WageRegion @relation(fields: [wageRegionCode], references: [code])
  unitVersions   OrgUnitVersion[]
  attendanceProfiles AttendanceImportProfile[]
  attendanceImports AttendanceImport[]
  rawPunches RawPunch[]
  @@map("site")
}

// Stable unit identity; assignments survive changes to dated organization versions.
model OrgUnit {
  id              String @id @default(uuid()) @db.Uuid
  code            String @unique @db.VarChar(40)
  versions        OrgUnitVersion[] @relation("UnitVersions")
  childVersions   OrgUnitVersion[] @relation("ParentUnit")
  roleAssignments RoleAssignment[]
  employees       OrgAssignment[]
  policies SitePolicy[]
  periods BusinessPeriod[]
  transfersFrom PersonnelTransfer[] @relation("TransferFrom")
  transfersTo PersonnelTransfer[] @relation("TransferTo")
  shiftDefinitions ShiftDefinition[]
  shiftPlans ShiftPlan[]
  attendanceDays DailyAttendance[]
  overtimeRequests OvertimeRequest[]
  overtimeActuals OvertimeActual[]
  correctionItems AttendanceCorrectionItem[]
  leaveTypes LeaveType[]
  leavePolicies LeavePolicy[]
  sourceCoverage AttendanceSourceCoverage[]
  teamConfirmations AttendanceTeamConfirmation[]
  workshopClosures AttendanceWorkshopClosure[]
  salaryComponents SalaryComponent[]
  payrollConfigurations PayrollConfiguration[]
  payrollPeriods PayrollPeriod[]
  payrollInputTeamAllocations PayrollInputTeamAllocation[]
  overtimePayBuckets OvertimePayBucket[]
  payrollRuns PayrollRun[]
  notifications Notification[]
  insuranceChangeLists InsuranceChangeList[]
  c12Imports C12Import[]
  terminationPaymentItems TerminationPaymentItem[]
  benefitCatalogs BenefitCatalog[]
  benefitBatches BenefitAllocationBatch[] @relation("BenefitBatchScope")
  benefitAllocations BenefitAllocation[] @relation("BenefitAllocationUnit")
  rotationPatterns ShiftRotationPattern[]
  shiftSwaps ShiftSwapRequest[] @relation("ShiftSwapTeam")
  @@map("org_unit")
  salaryPaymentItems SalaryPaymentItem[]
}

model OrgUnitVersion {
  id                String @id @default(uuid()) @db.Uuid
  orgUnitId         String @map("org_unit_id") @db.Uuid
  parentId          String? @map("parent_id") @db.Uuid
  siteId            String? @map("site_id") @db.Uuid
  name              String @db.VarChar(150)
  type              OrgUnitType @map("unit_type")
  level             Int
  costCenterCode    String? @map("cost_center_code") @db.VarChar(40)
  accountingAccount String? @map("accounting_account") @db.VarChar(10)
  effectiveFrom     DateTime @map("effective_from") @db.Date
  effectiveTo       DateTime? @map("effective_to") @db.Date
  orgUnit           OrgUnit @relation("UnitVersions", fields: [orgUnitId], references: [id])
  parent            OrgUnit? @relation("ParentUnit", fields: [parentId], references: [id])
  site              Site? @relation(fields: [siteId], references: [id])
  @@index([parentId, effectiveFrom, effectiveTo])
  @@map("org_unit_version")
}

model JobGrade {
  id     String @id @default(uuid()) @db.Uuid
  code   String @unique @db.VarChar(10)
  name   String @db.VarChar(100)
  titles JobTitle[]
  @@map("job_grade")
}

model JobTitle {
  id         String @id @default(uuid()) @db.Uuid
  code       String @unique @db.VarChar(32)
  name       String @db.VarChar(100)
  jobLevel   Int @map("job_level")
  jobGradeId String @map("job_grade_id") @db.Uuid
  jobGrade   JobGrade @relation(fields: [jobGradeId], references: [id])
  employees  Employee[]
  @@map("job_title")
}

model Employee {
  id              String @id @default(uuid()) @db.Uuid
  code            String @unique @db.VarChar(32)
  fullName        String @map("full_name") @db.VarChar(120)
  gender          Gender
  dob             DateTime @db.Date
  nationality     String @default("Việt Nam") @db.VarChar(80)
  email           String? @db.VarChar(150)
  phone           String? @db.VarChar(30)
  hireDate        DateTime @map("hire_date") @db.Date
  status          EmployeeStatus @default(ACTIVE)
  terminationDate DateTime? @map("termination_date") @db.Date
  jobTitleId      String? @map("job_title_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  jobTitle        JobTitle? @relation(fields: [jobTitleId], references: [id])
  assignments     OrgAssignment[]
  accounts        UserAccount[]
  exclusions      EmployeeExclusion[]
  contracts EmploymentContract[]
  transfers PersonnelTransfer[]
  shiftSchedules ShiftSchedule[]
  rawPunches RawPunch[]
  attendanceDays DailyAttendance[]
  overtimeMembers OvertimeMember[]
  overtimeActuals OvertimeActual[]
  correctionItems AttendanceCorrectionItem[]
  leaveBalances LeaveBalance[]
  leaveRequests LeaveRequest[]
  payPlans EmployeePayPlan[]
  payrollInputLines PayrollInputLine[]
  overtimePayBuckets OvertimePayBucket[]
  identity EmployeeIdentity?
  identityHistory EmployeeIdentityHistory[]
  bankAccounts EmployeeBankAccount[]
  dependents EmployeeDependent[]
  taxProfiles TaxProfile[]
  specialStatuses EmployeeSpecialStatus[]
  salaryDecisions SalaryDecision[]
  salaries EmployeeSalary[]
  retroCandidates RetroCandidate[]
  insuranceContributions InsuranceContribution[]
  taxWithholdings TaxWithholding[]
  taxDeductionUsages TaxDeductionUsage[]
  payrollEmployees PayrollEmployee[]
  payslips Payslip[]
  salaryPaymentItems SalaryPaymentItem[]
  bonusAllocations BonusAllocation[]
  retroCalculations RetroCalculation[]
  payrollAdjustments PayrollAdjustment[]
  payrollRunErrors PayrollRunError[]
  @@index([fullName])
  insuranceChangeStates InsuranceChangeState[]
  insuranceChangeItems InsuranceChangeItem[]
  c12Differences C12Difference[]
  terminationDecisions TerminationDecision[]
  severanceAllowances SeveranceAllowance[]
  terminationPaymentItems TerminationPaymentItem[]
  benefitCandidates BenefitAllocationCandidate[]
  benefitAllocations BenefitAllocation[]
  taxFinalizations AnnualTaxFinalization[]
  shiftSwaps ShiftSwapRequest[]
  sicknessMaternityRecords SicknessMaternityRecord[]
  @@map("employee")
}

model OrgAssignment {
  id              String @id @default(uuid()) @db.Uuid
  employeeId      String @map("employee_id") @db.Uuid
  orgUnitId       String @map("org_unit_id") @db.Uuid
  isPrimary       Boolean @default(true) @map("is_primary")
  allocationRatio Decimal @map("allocation_ratio") @db.Decimal(5,2)
  effectiveFrom   DateTime @map("effective_from") @db.Date
  effectiveTo     DateTime? @map("effective_to") @db.Date
  employee        Employee @relation(fields: [employeeId], references: [id])
  orgUnit         OrgUnit @relation(fields: [orgUnitId], references: [id])
  @@index([orgUnitId, effectiveFrom, effectiveTo])
  @@map("org_assignment")
}

model Role {
  code        RoleCode @id
  name        String @db.VarChar(80)
  permissions String[] @map("function_permissions")
  assignments RoleAssignment[]
  @@map("role")
}

model UserAccount {
  id            String @id @default(uuid()) @db.Uuid
  username      String @unique @db.VarChar(64)
  displayName   String @map("display_name") @db.VarChar(120)
  passwordHash  String @map("password_hash")
  status        AccountStatus @default(ACTIVE)
  employeeId    String? @map("employee_id") @db.Uuid
  failedLogins  Int @default(0) @map("failed_logins")
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz(3)
  revision      Int @default(1)
  mustChangePassword Boolean @default(false) @map("must_change_password")
  passwordChangedAt DateTime @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  employee      Employee? @relation(fields: [employeeId], references: [id])
  assignments   RoleAssignment[]
  sessions      WebSession[]
  exclusions    EmployeeExclusion[]
  auditLogs     AuditLog[]
  shiftPlans ShiftPlan[]
  shiftHistory ShiftPlanHistory[]
  attendanceImports AttendanceImport[]
  overtimeRequests OvertimeRequest[]
  overtimeHistory OvertimeHistory[]
  passwordHistory PasswordHistory[]
  correctionsCreated AttendanceCorrection[] @relation("CorrectionCreator")
  correctionsDecided AttendanceCorrection[] @relation("CorrectionReviewer")
  correctionEvidence AttendanceCorrectionEvidence[]
  correctionHistory AttendanceCorrectionHistory[]
  leaveTypeVersions LeaveTypeVersion[]
  leavePolicyVersions LeavePolicyVersion[]
  leaveOperations LeaveOperation[]
  leaveRequests LeaveRequest[]
  leaveRequestHistory LeaveRequestHistory[]
  sourceCoverage AttendanceSourceCoverage[]
  teamConfirmations AttendanceTeamConfirmation[]
  workshopClosures AttendanceWorkshopClosure[]
  periodLockEvents AttendancePeriodLockEvent[]
  salaryComponentVersions SalaryComponentVersion[]
  payrollConfigurationVersions PayrollConfigurationVersion[]
  employeePayPlanVersions EmployeePayPlanVersion[]
  payrollInputBatchesCreated PayrollInputBatch[] @relation("PayrollInputBatchCreator")
  payrollInputEvidence PayrollInputEvidence[]
  payrollInputHistory PayrollInputHistory[]
  identitiesUpdated EmployeeIdentity[]
  identityHistory EmployeeIdentityHistory[]
  bankAccountsCreated EmployeeBankAccount[]
  dependentsCreated EmployeeDependent[]
  taxProfilesCreated TaxProfile[]
  specialStatusesCreated EmployeeSpecialStatus[]
  salaryDecisions SalaryDecision[]
  retroCandidatesResolved RetroCandidate[]
  insuranceRates InsuranceRate[]
  taxRulesets TaxRuleset[]
  taxWithholdings TaxWithholding[]
  payrollRuns PayrollRun[]
  payrollSheetsApproved PayrollSheet[] @relation("PayrollSheetApprover")
  payrollSheetsLocked PayrollSheet[] @relation("PayrollSheetLocker")
  payrollSheetHistory PayrollSheetHistory[]
  payrollSnapshots PayrollSnapshot[]
  payslipExports PayslipExport[]
  payslipsIssued Payslip[]
  bankFileTemplates BankFileTemplate[]
  salaryPaymentsCreated SalaryPaymentBatch[] @relation("SalaryPaymentCreator")
  salaryPaymentsPaid SalaryPaymentBatch[] @relation("SalaryPaymentPayer")
  salaryPaymentsCancelled SalaryPaymentBatch[] @relation("SalaryPaymentCanceller")
  bonusPlansCreated BonusPlan[] @relation("BonusPlanCreator")
  bonusPlansConfirmed BonusPlan[] @relation("BonusPlanConfirmer")
  bonusAllocations BonusAllocation[]
  retroCalculationsCreated RetroCalculation[] @relation("RetroCalculationCreator")
  retroCalculationsDecided RetroCalculation[] @relation("RetroCalculationDecider")
  payrollAdjustmentsCreated PayrollAdjustment[] @relation("PayrollAdjustmentCreator")
  payrollAdjustmentsConfirmed PayrollAdjustment[] @relation("PayrollAdjustmentConfirmer")
  auditIntegrityChecks AuditIntegrityCheck[]
  notifications NotificationRecipient[]
  insuranceListsGenerated InsuranceChangeList[] @relation("InsuranceListGenerator")
  insuranceListsFinalized InsuranceChangeList[] @relation("InsuranceListFinalizer")
  c12Imports C12Import[]
  terminationsCreated TerminationDecision[] @relation("TerminationCreator")
  terminationsConfirmed TerminationDecision[] @relation("TerminationConfirmer")
  benefitVersionsCreated BenefitCatalogVersion[] @relation("BenefitVersionCreator")
  benefitBatchesCreated BenefitAllocationBatch[] @relation("BenefitBatchCreator")
  benefitBatchesConfirmed BenefitAllocationBatch[] @relation("BenefitBatchConfirmer")
  taxFinalizationsCreated AnnualTaxFinalization[] @relation("TaxFinalizationCreator")
  taxFinalizationsCompleted AnnualTaxFinalization[] @relation("TaxFinalizationCompleter")
  rotationVersionsCreated ShiftRotationPatternVersion[] @relation("RotationVersionCreator")
  shiftSwapsCreated ShiftSwapRequest[] @relation("ShiftSwapCreator")
  shiftSwapsDecided ShiftSwapRequest[] @relation("ShiftSwapDecider")
  shiftSwapHistory ShiftSwapHistory[] @relation("ShiftSwapActor")
  siBenefitsCreated SicknessMaternityRecord[] @relation("SiBenefitCreator")
  siBenefitsPaid SicknessMaternityRecord[] @relation("SiBenefitPayer")
  reportRuns ReportRun[] @relation("ReportRunRequester")
  @@map("user_account")
}

model PasswordHistory {
  id String @id @default(uuid()) @db.Uuid
  userAccountId String @map("user_account_id") @db.Uuid
  passwordHash String @map("password_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  userAccount UserAccount @relation(fields: [userAccountId], references: [id])
  @@index([userAccountId, createdAt])
  @@map("password_history")
}

model RoleAssignment {
  id             String @id @default(uuid()) @db.Uuid
  userAccountId  String @map("user_account_id") @db.Uuid
  roleCode       RoleCode @map("role_code")
  scopeOrgUnitId String @map("scope_org_unit_id") @db.Uuid
  effectiveFrom  DateTime @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  userAccount    UserAccount @relation(fields: [userAccountId], references: [id])
  role           Role @relation(fields: [roleCode], references: [code])
  scopeOrgUnit   OrgUnit @relation(fields: [scopeOrgUnitId], references: [id])
  @@index([userAccountId, effectiveFrom, effectiveTo])
  @@map("role_assignment")
}

model EmployeeExclusion {
  id            String @id @default(uuid()) @db.Uuid
  userAccountId String @map("user_account_id") @db.Uuid
  employeeId    String @map("employee_id") @db.Uuid
  effectiveFrom DateTime @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date
  userAccount   UserAccount @relation(fields: [userAccountId], references: [id])
  employee      Employee @relation(fields: [employeeId], references: [id])
  @@index([userAccountId, employeeId])
  @@map("employee_exclusion")
}

model WebSession {
  id                String @id @default(uuid()) @db.Uuid
  tokenHash         String @unique @map("token_hash") @db.Char(64)
  userAccountId     String @map("user_account_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime @map("last_seen_at") @db.Timestamptz(3)
  expiresAt         DateTime @map("expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime @map("absolute_expires_at") @db.Timestamptz(3)
  userAccount       UserAccount @relation(fields: [userAccountId], references: [id])
  @@index([userAccountId])
  @@map("web_session")
}

model AuditLog {
  id          BigInt @id @default(autoincrement())
  actorId     String? @map("actor_id") @db.Uuid
  entityType  String @map("entity_type") @db.VarChar(80)
  entityId    String @map("entity_id")
  action      String @db.VarChar(40)
  result      String @db.VarChar(40)
  occurredAt  DateTime @map("occurred_at") @db.Timestamptz(3)
  oldValue    Json? @map("old_value")
  newValue    Json? @map("new_value")
  ipAddress   String? @map("ip_address") @db.VarChar(64)
  prevHash    String @map("prev_hash") @db.Char(64)
  recordHash  String @map("record_hash") @db.Char(64)
  scopeOrgUnitId String? @map("scope_org_unit_id") @db.Uuid
  actor       UserAccount? @relation(fields: [actorId], references: [id])
  @@index([scopeOrgUnitId, occurredAt(sort: Desc)], map: "audit_log_scope_time_idx")
  @@index([occurredAt(sort: Desc)], map: "audit_log_time_idx")
  @@index([actorId, occurredAt(sort: Desc)], map: "audit_log_actor_time_idx")
  @@index([entityType, entityId], map: "audit_log_entity_idx")
  @@index([result, occurredAt(sort: Desc)], map: "audit_log_result_time_idx")
  @@map("audit_log")
}

enum AuditIntegrityStatus {
  VALID
  BROKEN
}

model AuditIntegrityCheck {
  id String @id @default(uuid()) @db.Uuid
  trigger String @db.VarChar(16)
  status AuditIntegrityStatus
  fromId BigInt? @map("from_id")
  toId BigInt? @map("to_id")
  checkedCount Int @map("checked_count")
  firstBrokenId BigInt? @map("first_broken_id")
  failureReason String? @map("failure_reason") @db.VarChar(40)
  startedAt DateTime @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime @map("finished_at") @db.Timestamptz(3)
  triggeredById String? @map("triggered_by_id") @db.Uuid
  triggeredBy UserAccount? @relation(fields: [triggeredById], references: [id], onDelete: Restrict)
  @@index([startedAt(sort: Desc)], map: "audit_integrity_check_time_idx")
  @@map("audit_integrity_check")
}

model Notification {
  id String @id @default(uuid()) @db.Uuid
  type String @map("notification_type") @db.VarChar(40)
  title String @db.VarChar(300)
  payload Json @default("{}")
  linkKey String @map("link_key") @db.VarChar(40)
  scopeOrgUnitId String? @map("scope_org_unit_id") @db.Uuid
  dedupeKey String? @unique(map: "notification_dedupe_key") @map("dedupe_key") @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  scopeOrgUnit OrgUnit? @relation(fields: [scopeOrgUnitId], references: [id], onDelete: Restrict)
  recipients NotificationRecipient[]
  @@index([createdAt(sort: Desc)], map: "notification_time_idx")
  @@map("notification")
}

model NotificationRecipient {
  notificationId String @map("notification_id") @db.Uuid
  userAccountId String @map("user_account_id") @db.Uuid
  readAt DateTime? @map("read_at") @db.Timestamptz(3)
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userAccount UserAccount @relation(fields: [userAccountId], references: [id], onDelete: Restrict)
  @@id([notificationId, userAccountId])
  @@index([userAccountId, readAt], map: "notification_recipient_inbox_idx")
  @@map("notification_recipient")
}

enum ApplicationBasis {
  WORK_DATE
  TAX_YEAR
  PAYMENT_DATE
}

enum SitePolicyKey {
  CUTOFF_DAY
}

enum PolicyStatus {
  SIMULATION
  BUSINESS_CONFIRMED
}

enum BusinessPeriodType {
  ATTENDANCE
}

enum BusinessPeriodStatus {
  PLANNED
  OPEN
  CLOSED
  LOCKED
}

enum AttendanceWorkshopClosureAction {
  CLOSE
  RETURN
}

enum AttendancePeriodLockAction {
  RETURN
  LOCK
}

model LegalParameter {
  id                    String           @id @default(uuid()) @db.Uuid
  paramCode             String           @map("param_code") @db.VarChar(80)
  scopeKey              String           @map("scope_key") @db.VarChar(64)
  subjectType           String           @map("subject_type") @db.VarChar(64)
  applicationBasis      ApplicationBasis @map("application_basis")
  value                 Json
  unit                  String           @db.VarChar(32)
  effectiveFrom         DateTime         @map("effective_from") @db.Date
  effectiveTo           DateTime?        @map("effective_to") @db.Date
  documentEffectiveDate DateTime         @map("document_effective_date") @db.Date
  legalBasis            String           @map("legal_basis")
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([paramCode, scopeKey, subjectType, applicationBasis, effectiveFrom, effectiveTo])
  @@map("legal_parameter")
}

model SitePolicy {
  id                String        @id @default(uuid()) @db.Uuid
  orgUnitId         String        @map("org_unit_id") @db.Uuid
  policyKey         SitePolicyKey @map("policy_key")
  value             Int
  status            PolicyStatus
  decisionReference String        @map("decision_reference") @db.VarChar(200)
  effectiveFrom     DateTime      @map("effective_from") @db.Date
  effectiveTo       DateTime?     @map("effective_to") @db.Date
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  orgUnit OrgUnit @relation(fields: [orgUnitId], references: [id])
  periods BusinessPeriod[]
  @@index([orgUnitId, policyKey, effectiveFrom, effectiveTo])
  @@map("site_policy")
}

model BusinessPeriod {
  id              String               @id @default(uuid()) @db.Uuid
  code            String               @db.VarChar(64)
  periodType      BusinessPeriodType   @default(ATTENDANCE) @map("period_type")
  scopeOrgUnitId  String               @map("scope_org_unit_id") @db.Uuid
  dateFrom        DateTime             @map("date_from") @db.Date
  dateTo          DateTime             @map("date_to") @db.Date
  cutoffDay       Int                  @map("cutoff_day")
  cutoffPolicyId  String               @map("cutoff_policy_id") @db.Uuid
  status          BusinessPeriodStatus @default(PLANNED)
  revision        Int                  @default(0)
  openedAt        DateTime?            @map("opened_at") @db.Timestamptz(3)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  scopeOrgUnit OrgUnit @relation(fields: [scopeOrgUnitId], references: [id])
  cutoffPolicy SitePolicy @relation(fields: [cutoffPolicyId], references: [id])
  attendanceImports AttendanceImport[]
  attendanceDays DailyAttendance[]
  punchProcessing PunchProcessing[]
  overtimeActuals OvertimeActual[]
  corrections AttendanceCorrection[]
  correctionItems AttendanceCorrectionItem[]
  sourceCoverage AttendanceSourceCoverage[]
  teamConfirmations AttendanceTeamConfirmation[]
  workshopClosures AttendanceWorkshopClosure[]
  periodLockEvents AttendancePeriodLockEvent[]
  overtimePayBuckets OvertimePayBucket[]
  @@unique([code])
  @@index([periodType, scopeOrgUnitId, dateFrom, dateTo])
  @@map("business_period")
}

enum PayrollPeriodStatus {
  OPEN
  LOCKED
}

enum PayrollInputStatus {
  DRAFT
  VALIDATED
  CONFIRMED
  RETURNED
  SUPERSEDED
}

enum PayrollInputProvenance {
  SIMULATION
  BUSINESS_CONFIRMED
}

model PayrollPeriod {
  id String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(64)
  siteOrgUnitId String @map("site_org_unit_id") @db.Uuid
  dateFrom DateTime @map("date_from") @db.Date
  dateTo DateTime @map("date_to") @db.Date
  expectedPaymentDate DateTime? @map("expected_payment_date") @db.Date
  status PayrollPeriodStatus @default(OPEN)
  isInitial Boolean @default(false) @map("is_initial")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  siteOrgUnit OrgUnit @relation(fields: [siteOrgUnitId], references: [id])
  batches PayrollInputBatch[]
  retroCandidates RetroCandidate[]
  insuranceContributions InsuranceContribution[]
  taxWithholdings TaxWithholding[]
  salaryPaymentItems SalaryPaymentItem[]
  bonusPlans BonusPlan[]
  retroCalculations RetroCalculation[]
  adjustmentsTargeted PayrollAdjustment[] @relation("PayrollAdjustmentTarget")
  adjustmentsOriginated PayrollAdjustment[] @relation("PayrollAdjustmentOrigin")
  adjustmentsApplied PayrollAdjustment[] @relation("PayrollAdjustmentApplied")
  payrollRuns PayrollRun[]
  payrollSheet PayrollSheet?
  @@index([siteOrgUnitId, dateFrom, dateTo])
  terminationPaymentItems TerminationPaymentItem[]
  benefitBatches BenefitAllocationBatch[]
  benefitAllocations BenefitAllocation[]
  @@map("payroll_period")
}

model PayrollInputBatch {
  id String @id @default(uuid()) @db.Uuid
  payrollPeriodId String @map("payroll_period_id") @db.Uuid
  sourceSystem String @map("source_system") @db.VarChar(80)
  sourceDocumentNo String @map("source_document_no") @db.VarChar(160)
  sourceVersion String @map("source_version") @db.VarChar(80)
  mappingVersion String @map("mapping_version") @db.VarChar(80)
  provenance PayrollInputProvenance
  preparedBy String @map("prepared_by") @db.VarChar(200)
  sourceApprovedBy String? @map("source_approved_by") @db.VarChar(200)
  sourceApprovedAt DateTime? @map("source_approved_at") @db.Date
  sourceApprovalReference String? @map("source_approval_reference") @db.VarChar(500)
  reason String @db.VarChar(2000)
  attendancePeriodIds String[] @map("attendance_period_ids") @db.Uuid
  status PayrollInputStatus @default(DRAFT)
  revision Int @default(1)
  contentHash String @map("content_hash") @db.Char(64)
  payloadCipher String @map("payload_cipher")
  validationCipher String? @map("validation_cipher")
  fileName String? @map("file_name") @db.VarChar(255)
  fileHash String? @map("file_hash") @db.Char(64)
  supersedesBatchId String? @map("supersedes_batch_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdById String @map("created_by_id") @db.Uuid
  payrollPeriod PayrollPeriod @relation(fields: [payrollPeriodId], references: [id])
  createdBy UserAccount @relation("PayrollInputBatchCreator", fields: [createdById], references: [id])
  supersedesBatch PayrollInputBatch? @relation("PayrollInputBatchReplacement", fields: [supersedesBatchId], references: [id])
  replacements PayrollInputBatch[] @relation("PayrollInputBatchReplacement")
