# Local development only. db:setup generates backend/.env with a random password.
DATABASE_URL="postgresql://hrtp_demo:CHANGE_ME@127.0.0.1:5433/hrtp_demo?schema=public&connection_limit=5&connect_timeout=3&pool_timeout=3&socket_timeout=3"
HOST=127.0.0.1
PORT=3000
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep outside version control; back up securely with the database. Never rotate in place.
HR_DATA_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# Cookie is insecure only for local HTTP. Use HTTPS and true in deployment.
COOKIE_SECURE=false
WEB_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
AUTH_IDLE_MINUTES=15
AUTH_ABSOLUTE_HOURS=8
AUTH_MAX_FAILURES=5
AUTH_LOCK_MINUTES=15
