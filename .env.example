# Docker Compose configuration. Copy to .env and fill in the secrets:
#   cp .env.example .env
#   openssl rand -hex 24      -> POSTGRES_PASSWORD (hex keeps the DATABASE_URL valid)
#   openssl rand -base64 32   -> HR_DATA_KEY (back it up: it decrypts stored contracts)
POSTGRES_PASSWORD=
HR_DATA_KEY=

# Admin account created by `docker compose exec backend node prisma/seed.cjs`.
# Password: >= 12 chars with upper, lower, digit and symbol. Keep it in single
# quotes so Compose does not expand "$". It only applies on first creation;
# change it later in the app.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=''
ADMIN_NAME=Quản trị hệ thống

# Host ports
WEB_PORT=8080
API_PORT=3000
DB_PORT=5434

# AI-02 business assistant (docs 24). Off by default; the key stays on the server only.
AI_BUSINESS_ASSISTANT_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=8000
AI_MAX_OUTPUT_TOKENS=1024
AI_RATE_LIMIT_PER_HOUR=20
AI_DAILY_REQUEST_BUDGET=500

# Key rotation (FR-X.2): HR_DATA_KEY stays key v1. Add new keys as v2:<base64>,v3:<base64>, switch the active one,
# then run `npm run keys:rotate`; drop an old key only when `npm run keys:rotate -- --check` lists it as removable.
HR_DATA_KEYS=
HR_DATA_KEY_ACTIVE=v1

# Hourly encrypted backups: docker compose --profile backup up -d (FR-X.4). Must differ from HR_DATA_KEY; keep a copy off this host.
#   openssl rand -base64 32 -> BACKUP_ENCRYPTION_KEY
BACKUP_ENCRYPTION_KEY=
BACKUP_HOST_DIR=./backups

# Optional HTTPS front: docker compose --profile tls up -d with deploy/certs/tls.crt + tls.key.
# When TLS is on, set COOKIE_SECURE=true and put the https origin into WEB_ORIGINS.
TLS_PORT=8443
COOKIE_SECURE=false
WEB_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Demo punch-clock simulator (service `simulator`, http://127.0.0.1:4100). Logs in as ADMIN_USERNAME/ADMIN_PASSWORD
# unless SIM_USERNAME/SIM_PASSWORD are set. SIM_AUTOSTART=true starts the clock at the current time (SIM_SPEED=1 = real time).
SIM_PORT=4100
SIM_AUTOSTART=false
SIM_SPEED=1

# LOCAL DEMO ONLY: one password for every account (npm run demo:accounts / demo:setup), shown in plain text on the
# login form after rebuilding the frontend. Leave empty for any real deployment. ≥ 12 chars, upper, lower, digit, symbol.
DEMO_PASSWORD=

# Attendance import transaction budget in ms (default 90000). Raise only for a one-off demo backfill of many weeks at a
# large site (e.g. 300000), then remove: while it runs, the import lock blocks other attendance imports.
# ATTENDANCE_TRANSACTION_TIMEOUT_MS=90000
